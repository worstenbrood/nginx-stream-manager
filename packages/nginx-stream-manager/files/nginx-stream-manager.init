#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
PROG=/usr/libexec/nginx-stream-manager

start_service() {
	local enabled
	config_load nginx_stream_manager
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	"$PROG" prepare || return 1
	procd_open_instance nginx
	procd_set_param command /usr/sbin/nginx -p /var/run/nginx-stream-manager/ -c /var/run/nginx-stream-manager/nginx.conf
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
	procd_open_instance maintenance
	procd_set_param command /usr/libexec/nginx-stream-manager-maintenance
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	local enabled
	config_load nginx_stream_manager
	config_get_bool enabled main enabled 0
	if [ "$enabled" -ne 1 ]; then
		stop
	elif [ -s /var/run/nginx-stream-manager/nginx.pid ] && kill -0 "$(cat /var/run/nginx-stream-manager/nginx.pid)" 2>/dev/null; then
		"$PROG" reload
	else
		start
	fi
}

stop_service() {
	"$PROG" cleanup
}

service_triggers() {
	procd_add_reload_trigger nginx_stream_manager
}
