#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
PROG=/usr/libexec/nginx-stream-manager

start_service() {
	local enabled
	NSM_PREPARED=0
	enabled=$("$PROG" configured) || return 1
	[ "$enabled" -eq 1 ] || { NSM_PREPARED=disabled; return 0; }
	if "$PROG" running >/dev/null; then
		: # Repeated start is idempotent; configuration changes use reload.
	else
		"$PROG" prepare || return 1
	fi
	NSM_PREPARED=1
	procd_open_instance nginx
	procd_set_param command /usr/sbin/nginx -p /var/run/nginx-stream-manager/ -c /var/run/nginx-stream-manager/nginx.conf
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
	procd_open_instance maintenance
	procd_set_param command /usr/libexec/nginx-stream-manager-maintenance
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	local enabled
	enabled=$("$PROG" configured) || return 1
	if [ "$enabled" -ne 1 ]; then
		stop
	elif "$PROG" running >/dev/null; then
		"$PROG" reload
	else
		start
	fi
}

service_started() {
	[ "$NSM_PREPARED" = disabled ] && { "$PROG" stopped; return $?; }
	[ "$NSM_PREPARED" = 1 ] || { "$PROG" stopped; return 1; }
	"$PROG" started && return 0
	procd_kill nginx-stream-manager
	"$PROG" stopped
	return 1
}

service_stopped() {
	# rc.common calls this after asking procd to terminate the instances.
	"$PROG" stopped
}

service_triggers() {
	procd_add_reload_trigger nginx_stream_manager
}
