# Example only. TEST-NET addresses must be replaced. Manager disabled.
config global 'main'
    option enabled '0'
    option workers 'auto'
    option connections '1024'
    option nofile '4096'
    option log_mb '4'

config pool 'application'
    option name 'Application pool'
    option method 'least_conn'

config backend 'node_a'
    option enabled '1'
    option pool 'application'
    option address '192.0.2.10'
    option port '9000'
    option weight '2'
    option max_fails '2'
    option fail_timeout '10'

config backend 'node_b'
    option enabled '1'
    option pool 'application'
    option address '192.0.2.11'
    option port '9000'
    option weight '1'

config service 'application_tcp'
    option enabled '1'
    option protocol 'tcp'
    option listen_address '0.0.0.0'
    option listen_port '19000'
    option pool 'application'
    option transparent '0'
    option connect_timeout '5'
    option timeout '600'
    option access_log '1'
    list allow_source '192.0.2.0/24'
